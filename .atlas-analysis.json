  "keyFeatures": [
    "Quarto extensions for pediatric, adult, forensic, and Luria-style neuropsychological report formats",
    "PDF rendering via Typst with professional clinic-ready typography and layout",
    "Modular section partials for cognitive domain findings, behavioral observations, and SIRF summaries",
    "CONFIDENTIAL header auto-injected on all pages after page 1",
    "Integration with the cingulate R package for data processing and visualization",
    "Optional AI-assisted narrative generation via a local Ollama LLM backend",
    "YAML front matter for patient demographics and case metadata",
    "Brand theming via _brand.yml for consistent visual identity"
  ],
  "publicApiSurface": [
    "quarto use template brainworkup/neurotyp-luria",
    "quarto use template brainworkup/neurotyp-adult",
    "quarto use template brainworkup/neurotyp-pediatric",
    "quarto use template brainworkup/neurotyp-forensic",
    "quarto add brainworkup/neurotyp-adult",
    "quarto update extension brainworkup/neurotyp-adult",
    "quarto render template.qmd --to neurotyp-adult-typst",
    "quarto render template.qmd --to neurotyp-pediatric-typst",
    "quarto render template.qmd --to neurotyp-forensic-typst",
    "YAML front matter: patient, name, dob, age, doe, case_number, date_of_report",
    "_brand.yml brand configuration",
    "_extensions/neurotyp-*/typst-template.typ",
    "_extensions/neurotyp-*/typst-show.typ"
  ]
